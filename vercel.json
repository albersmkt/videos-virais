{
  "builds": [
    {"src": "api/index.py", "use": "@vercel/python", "config": {"includeFiles": ["server.py", "web/catalog.json"]}},
    {"src": "web/**", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/(personal|state|login|register|logout|password|hooks|script)/?", "dest": "/api/index.py?action=$1"},
    {"src": "/", "dest": "/web/index.html"},
    {"src": "/(modelos.js|app.js|style.css|catalog.json)", "dest": "/web/$1"}
  ]
}
